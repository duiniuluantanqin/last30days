# Add this as a separate site block alongside your existing website.
# Replace the domain; do not replace your entire Caddyfile.
archive.example.com {
    root * /var/www/html/last30days/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'none'; style-src 'self'; img-src https: http:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
    file_server
    handle_errors {
        rewrite * /404.html
        file_server
    }
}
